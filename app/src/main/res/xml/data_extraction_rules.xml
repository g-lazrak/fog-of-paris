<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Les cellules révélées sont un historique de déplacements :
     jamais de sauvegarde dans le cloud (Google Drive). Le transfert direct vers
     un nouveau téléphone (câble / Wi-Fi local) reste permis : les données ne
     passent par aucun serveur. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
</data-extraction-rules>
